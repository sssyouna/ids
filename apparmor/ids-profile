#include <tunables/global>

/usr/bin/python3 flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/python>

  # Network packet capture capabilities
  network raw,
  network packet,

  # File access for IDS
  /app/** r,
  /app/sniff.py r,
  /usr/local/lib/python*/site-packages/scapy/** r,
  /usr/lib/python*/** r,
  /dev/urandom r,
  /dev/null rw,
  /dev/zero r,

  # Logging
  /app/logs/** rw,
  /var/log/** rw,

  # tcpdump for scapy (if needed)
  /usr/bin/tcpdump ix,

  # Deny everything else
  deny /etc/shadow r,
  deny /etc/passwd r,
}