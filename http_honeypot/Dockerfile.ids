FROM python:3.11

WORKDIR /app
COPY sniff.py /app/
COPY requirements.txt /app/

# Install system dependencies required for packet capture
RUN apt-get update && apt-get install -y \
    libpcap-dev \
    tcpdump \
    && rm -rf /var/lib/apt/lists/*

RUN pip install -r requirements.txt

CMD ["python", "sniff.py"]